# AgentGuard settings. Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Wallets marked "created by a script" are generated and saved for you; don't invent them.

# ---- XRP Ledger (testnet) ----
XRPL_RPC_URL=https://your-endpoint.xrp-testnet.quiknode.pro/your-token/   # Quicknode JSON-RPC (public testnet used if empty)
XRPL_WS_URL=wss://your-endpoint.xrp-testnet.quiknode.pro/your-token/      # Quicknode WebSocket (live feed, optional)
XRPL_AGENT_ADDRESS=rAgentAddress            # the AI agent's wallet (you create it, e.g. at the testnet faucet)
XRPL_AGENT_SECRET=sAgentSeed                # its seed: only used ONCE by setup_agent_wallet.py, before the master key is disabled
XRPL_ISSUER_ADDRESS=                        # Acme (passport issuer + treasury): created by scripts/setup_wallets.py
XRPL_ISSUER_SECRET=
XRPL_MERCHANT_ADDRESS=                      # Layer 1 demo merchant: created by scripts/setup_wallets.py
XRPL_MERCHANT_SECRET=
XRPL_VENDOR_FX_ADDRESS=                     # FX Rates Co. (verified-only): created by scripts/setup_vendors.py
XRPL_VENDOR_FX_SECRET=
XRPL_VENDOR_CRYPTO_ADDRESS=                 # Crypto Prices Co. (verified-only): created by scripts/setup_vendors.py
XRPL_VENDOR_CRYPTO_SECRET=
XRPL_VENDOR_NEWS_ADDRESS=                   # News Sentiment Co. XRPL account (paid via AP4M in the demo)
XRPL_VENDOR_NEWS_SECRET=
XRPL_VENDOR_ALPHA_ADDRESS=                  # the attacker (open account, no passport needed)
XRPL_VENDOR_ALPHA_SECRET=
XRPL_AGENT_SIGNER_ADDRESS=                  # the agent's own signing key (weight 1): created by setup_agent_wallet.py
XRPL_AGENT_SIGNER_SECRET=
XRPL_AGENTGUARD_ADDRESS=                    # AgentGuard's co-signing key (weight 1): created by setup_agent_wallet.py
XRPL_AGENTGUARD_SECRET=
XRPL_APPROVER_ADDRESS=                      # Acme's approver key (weight 2; the Ledger device's slot): created by setup_agent_wallet.py
XRPL_APPROVER_SECRET=

# ---- Mastercard Agent Pay for Machines (XRPL EVM testnet) ----
AP4M_API_BASE=https://hackathon.ap4m.build
AP4M_TEAM_NAME=gizmo geeks                  # must match the team's registration in the AP4M participant portal
AP4M_MODE=auto                              # auto = LIVE if sign-in works, else MOCK; or force live / mock
AGENT_EVM_PRIVATE_KEY=0xAgentKey            # the agent wallet REGISTERED in the AP4M portal (signs vouchers via AgentGuard's gate)
AGENT_EVM_ADDRESS=0xAgentAddress
MERCHANT_EVM_PRIVATE_KEY=0xMerchantKey      # the merchant payout / redeem wallet (needs a little XRP for gas)
MERCHANT_EVM_ADDRESS=0xMerchantAddress
EVM_RPC_URL=https://rpc.testnet.xrplevm.org
KILL_SWITCH_CLOSE_REAL_CHANNEL=false        # false = rehearsal (channel close simulated); true = live demo (really closes it)

# ---- AWS (checker AI, news risk score, Strands agent) ----
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your-bedrock-model-id               # a model your account can call in AWS_REGION (copy the ID from the Bedrock console)
# AWS credentials: use the normal AWS profile (~/.aws) or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN

# ---- Demo behaviour ----
STRIKES_BEFORE_REVOKE=3                     # refused purchases before the kill switch fires
DAILY_BUDGET_XRP=2                          # checker's daily budget on the XRPL lane
DAILY_BUDGET_RLUSD=2                        # checker's daily budget on the Mastercard lane
AUTO_CONFIRM_KILL=false                     # true = revoke + return float without waiting for the approver button
DEMO_MODE=live                              # live = normal run incl. the attack scene; calm = no attack; attack = injection everywhere
USE_LEDGER=false                            # reserved: true once a Ledger device / Speculos replaces the approver key
QUICKNODE_WEBHOOK_SECRET=change-me          # shared secret for POST /webhooks/quicknode
LEDGER_FEED=true                            # stream validated transactions on our accounts into the dashboard (XRPL_WS_URL)
AUTO_APPROVE_MAX_XRP=1                      # single purchases above this wait for a human (HOLD)
AUTO_APPROVE_MAX_RLUSD=0.40                 # default: the 0.50 RLUSD deeper news pull is held for a human
VOLATILITY_THRESHOLD=60                     # agent buys the deeper news pull at this risk score; 30 = always (demo)
